"""TIER 2 -- consume processed data -> figures (and/or tables).

Run with: ``pixi run results``. Assumes preprocessing already ran (the common case).
This is a thin runnable: it imports the library, reads ``data/processed``, and writes
to ``figures/``. It defines no reusable logic -- that lives in the package.
"""

import matplotlib

matplotlib.use("Agg")  # headless-safe; fine for batch figure generation
import matplotlib.pyplot as plt  # noqa: E402
import xarray as xr  # noqa: E402

from {{ package_name }} import dynamics  # noqa: E402
from {{ package_name }}.config import FIGURES, PROCESSED  # noqa: E402


def main():
    FIGURES.mkdir(parents=True, exist_ok=True)

    ds = xr.open_dataset(PROCESSED / "example.nc")

    fig, ax = plt.subplots()
    ds["temperature"].plot(ax=ax)
    ax.set_title(f"RMS anomaly = {dynamics.rms(ds['temperature_anom']):.3f}")

    out = FIGURES / "example.png"
    fig.savefig(out, dpi=150, bbox_inches="tight")
    plt.close(fig)
    print(f"wrote {out}")


if __name__ == "__main__":
    main()
